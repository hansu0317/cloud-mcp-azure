# ─── 앱 이름 (UI 타이틀, 사이드바 연결명 등) ────────────────────────────────────
VITE_APP_NAME=Quali CRM
VITE_CONN_NAME=Quali Cloud

# ─── 서버 포트 ────────────────────────────────────────────────────────────────
PORT=3000

# ─── 환경 구분 ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── LLM 타임아웃 ──────────────────────────────────────────────────────────
# 채팅 응답 최대 대기 시간(ms). 초과 시 Claude API 스트림 abort. 120초 권장
CHAT_TIMEOUT_MS=120000

# 테이블 스키마 describe 타임아웃(ms)
DESCRIBE_TIMEOUT_MS=60000

# Graceful Shutdown 강제 종료 대기(ms)
SHUTDOWN_TIMEOUT_MS=30000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# 분당 IP당 최대 요청 수. 사용자 규모에 맞게 조정 (10명 사내 → 20 정도 적절)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ─── 세션 관리 ───────────────────────────────────────────────────────────────
# 메모리에 유지할 최대 세션 수. 초과 시 가장 오래된 세션부터 정리
MAX_SESSIONS=200

# ─── API 키 인증 ─────────────────────────────────────────────────────────────
# 설정하면 모든 /api/* 요청에 X-API-Key 헤더 필수. 비워두면 인증 없이 동작
# 사내망 전용이라도 설정 권장. 예: openssl rand -hex 32
API_KEY=

# ─── LLM: Claude API 직접 호출 (필수) ────────────────────────────────────────
# 2026-08부터 hsagent 게이트웨이를 거치지 않는다 — 이 프로젝트가 직접 ANTHROPIC_API_KEY로
# Claude를 호출한다. 도구는 두 갈래: Dataverse 네이티브 MCP 커넥터(search/describe, 아래
# DATAVERSE_* 로 인증)와, 이 프로젝트가 직접 실행·가드하는 커스텀 도구(dataverse_query).
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5   # 기본값. 데모 응답 속도 우선 — 필요시 claude-sonnet-5 등으로 교체

# ─── Dataverse (필수) ─────────────────────────────────────────────────────────
# Dataverse Web API를 서비스 주체(client_credentials)로 직접 조회(GET 전용) +
# 같은 토큰으로 Dataverse 네이티브 MCP 엔드포인트(${DATAVERSE_URL}/api/mcp)에도 인증한다.
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_URL=https://quali.crm5.dynamics.com

# MAX_CONCURRENT_API=10   # 동시 Claude API 스트림 수

# ─── 로그 ─────────────────────────────────────────────────────────────────────
# 로그 파일 보관 일수 (rotating-file-stream 자동 회전)
LOG_MAX_FILES=30
