# ─── 실행 프로필 ────────────────────────────────────────────────────────────────
# 이 값 하나로 같은 백엔드 안에서 클라우드/로컬 LLM을 전환합니다.
# (2026-08-13부터 별도 mirror 저장소 없이 이 프로젝트 하나만 유지합니다.)
# 허용값: anthropic | ollama
LLM_PROVIDER=anthropic

# ─── 공통 LLM 우선 설정 ─────────────────────────────────────────────────────────
# 설정하면 아래 공급자별 기존(legacy) 변수보다 항상 우선합니다.
# 공급자를 바꿀 때 한 이름만 관리하려는 운영 환경에서 사용하세요.
# 빈 값으로 선언하면 빈 문자열이 실제 설정으로 적용될 수 있으므로, 사용하지 않을 때는
# 아래 두 줄을 주석 상태로 유지합니다.
# LLM_MODEL=claude-haiku-4-5
# LLM_BASE_URL=https://api.anthropic.com

# ─── Anthropic 프로필 ───────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic일 때 필수입니다.
ANTHROPIC_API_KEY=

# 공통값이 없을 때 사용하는 기존 변수와 기본값입니다.
# 모델: LLM_MODEL → ANTHROPIC_MODEL → claude-haiku-4-5
# 주소: LLM_BASE_URL → ANTHROPIC_BASE_URL → https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_VERSION=2023-06-01

# ─── Ollama 프로필 ──────────────────────────────────────────────────────────────
# LLM_PROVIDER=ollama일 때 사용합니다. Ollama native /api/chat 및 /api/tags만
# 지원하며 OpenAI 호환 /v1 프로토콜은 사용하지 않습니다.
# 모델은 먼저 `ollama pull qwen3:30b-a3b`처럼 설치해야 합니다.
# 모델: LLM_MODEL → LOCAL_LLM_MODEL → qwen3:30b-a3b
# 주소: LLM_BASE_URL → LOCAL_LLM_BASE_URL → http://localhost:11434
LOCAL_LLM_MODEL=qwen3:30b-a3b
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_KEEP_ALIVE=5m
# LOCAL_LLM_API_KEY는 Ollama native 어댑터에서 사용하지 않습니다.

# ─── 앱 표시 ────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Quali CRM
VITE_CONN_NAME=Dataverse

# Vite 개발 서버의 /api 프록시 대상입니다.
# 설정 시 VITE_API_PROXY_TARGET을 가장 먼저 사용하고, 미설정 시 아래 PORT를 사용합니다.
# 다른 호스트의 백엔드로 연결할 때만 활성화하세요.
# VITE_API_PROXY_TARGET=http://localhost:3000

# ─── 공통 서버 설정 ─────────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV는 Vite가 .env에서 production 값을 지원하지 않으므로 선언하지 않습니다.
# 프로덕션 빌드는 `npm run build`가 자동으로 production mode를 사용합니다.

# 채팅 한 번의 공급자 응답 제한 시간(ms). 로컬 CPU 추론은 더 큰 값이 필요할 수 있습니다.
CHAT_TIMEOUT_MS=120000
# Dataverse 스키마 조회 제한 시간(ms)
DESCRIBE_TIMEOUT_MS=60000
# graceful shutdown 뒤 강제 종료까지의 대기 시간(ms)
SHUTDOWN_TIMEOUT_MS=30000
# 운영 스크립트가 listen/종료를 기다리는 시간(초, 각각 1..300)
SERVER_START_TIMEOUT_SECONDS=30
SERVER_STOP_TIMEOUT_SECONDS=30

# API JSON body 최대 크기(bytes, 기본 1 MiB). Content-Length 및 실제 스트림에 적용됩니다.
MAX_REQUEST_BODY_BYTES=1048576

# 기본값은 loopback 프록시만 X-Forwarded-* 헤더의 출처로 신뢰합니다.
# 신뢰할 리버스 프록시 주소/CIDR만 쉼표로 추가하고, 인터넷 환경에서 *를 사용하지 마세요.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# 기본 false: FastAPI /docs, /redoc, /openapi.json을 노출하지 않습니다.
# 제한된 개발 환경에서만 true로 켜세요.
ENABLE_API_DOCS=false

# IP별 /api/chat, /api/describe 요청 제한
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
# 오래된 IP bucket을 제거하고 메모리 사용을 제한하는 최대 bucket 수
RATE_LIMIT_MAX_BUCKETS=10000

# 인메모리 대화 세션과 동시 LLM 스트림 상한
MAX_SESSIONS=200
MAX_CONCURRENT_API=10

# 설정하면 모든 /api/* 요청에 X-API-Key 헤더 또는 api_key 쿼리가 필요합니다.
# 현재 SPA는 이 키를 자동 전송하지 않으므로, 활성화할 경우 프록시에서 헤더를 주입하거나
# 별도의 클라이언트 인증 연동이 필요합니다.
API_KEY=

# ─── Dataverse ──────────────────────────────────────────────────────────────────
# 두 공급자 모두 동일한 서비스 주체(client_credentials)로 읽기 전용 조회합니다.
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_URL=https://quali.crm5.dynamics.com
# 일반 조회/메타데이터 응답 body 상한(bytes)
DATAVERSE_MAX_RESPONSE_BYTES=8388608
DATAVERSE_METADATA_MAX_RESPONSE_BYTES=67108864
# 429/5xx 등 일시 오류 재시도(0..5)와 지수 backoff 상한
DATAVERSE_MAX_RETRIES=2
DATAVERSE_RETRY_BASE_MS=300
DATAVERSE_RETRY_MAX_DELAY_MS=5000
# picklist 메타데이터 병렬 조회 상한(1..16)
DATAVERSE_PICKLIST_CONCURRENCY=4

# ─── 로그 ───────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic이면 logs/server.cloud.log,
# LLM_PROVIDER=ollama이면 logs/server.local.log에 기록합니다.
# 회전 로그는 1일 또는 50MB 기준으로 생성되고 gzip 압축되며 아래 개수만 보관합니다.
LOG_MAX_FILES=30
LOG_MAX_BYTES=52428800
