{
  "name": "crm-chat",
  "version": "2.0.0",
  "description": "Quali CRM AI Notebook — Claude API + Dataverse Web API (읽기 전용)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "python -m uvicorn backend.main:app --reload --port 3000",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "start": "python -m backend.main",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "dompurify": "^3.1.6",
    "marked": "^13.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^5.3.4"
  }
}
